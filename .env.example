# GEMINI_API_KEY: Required for Gemini AI API calls (Huzavin AI Assistant).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign HTTP-only admin session cookies.
# Leave blank in local dev to auto-generate an ephemeral secret, or set a strong random string in production.
SESSION_SECRET=""

# SUPABASE CONFIGURATION (Frontend Direct Auth & Data via @supabase/supabase-js):
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# OPTIONAL SERVER SUPABASE CONFIGURATION:
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
